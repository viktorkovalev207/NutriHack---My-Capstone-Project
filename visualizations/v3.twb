      <aliases enabled='yes' />
      <column caption='Simulated Score' datatype='integer' name='[Calculation_1710305777070080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN 0 THEN [ns_score]&#13;&#10;  WHEN 1 THEN [sim_sugar_minus5_score]&#13;&#10;  WHEN 2 THEN [sim_sugar_minus10_score]&#13;&#10;  WHEN 3 THEN [sim_protein_plus5_score]&#13;&#10;  WHEN 4 THEN [sim_protein_plus10_score]&#13;&#10;  WHEN 5 THEN [sim_salt_minus03_score]&#13;&#10;  WHEN 6 THEN [sim_salt_minus06_score]&#13;&#10;  WHEN 7 THEN [sim_fibre_plus3_score]&#13;&#10;  WHEN 8 THEN [sim_fibre_plus6_score]&#13;&#10;END' />
      </column>
      <column caption='Nutri-Score Grade' datatype='string' name='[Calculation_1710305777188865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN 0 THEN [ns_letter]&#13;&#10;  WHEN 1 THEN [sim_sugar_minus5_letter]&#13;&#10;  WHEN 2 THEN [sim_sugar_minus10_letter]&#13;&#10;  WHEN 3 THEN [sim_protein_plus5_letter]&#13;&#10;  WHEN 4 THEN [sim_protein_plus10_letter]&#13;&#10;  WHEN 5 THEN [sim_salt_minus03_letter]&#13;&#10;  WHEN 6 THEN [sim_salt_minus06_letter]&#13;&#10;  WHEN 7 THEN [sim_fibre_plus3_letter]&#13;&#10;  WHEN 8 THEN [sim_fibre_plus6_letter]&#13;&#10;END' />
      </column>
      <column caption='Scenario Label' datatype='string' name='[Calculation_1710305777270786]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN 0 THEN &quot;Original (no change)&quot;&#13;&#10;  WHEN 1 THEN &quot;Sugar -5g&quot;   WHEN 2 THEN &quot;Sugar -10g&quot;&#13;&#10;  WHEN 3 THEN &quot;Protein +5g&quot; WHEN 4 THEN &quot;Protein +10g&quot;&#13;&#10;  WHEN 5 THEN &quot;Salt -0.3g&quot;  WHEN 6 THEN &quot;Salt -0.6g&quot;&#13;&#10;  WHEN 7 THEN &quot;Fibre +3g&quot;   WHEN 8 THEN &quot;Fibre +6g&quot;&#13;&#10;END' />
      </column>
