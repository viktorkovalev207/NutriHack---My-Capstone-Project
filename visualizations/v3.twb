    <dashboard name='NutriHack' type='storyboard'>
      <style />
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='84440' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14730'>
              <flipboard active-id='7' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Nutri-Score in 30 seconds: A is best, E is worst.' captured-sheet='Intro' id='7' />
                  <story-point caption='The market clusters at grade D — 41% of products score D or E.' captured-sheet='Market Landscape' id='1' />
                  <story-point caption='9,861 products, sliced three ways — but 59% carry at least one estimated value.' captured-sheet='Defense' id='2' />
                  <story-point caption='Keep only the 4,029 fully-measured products — grade D still dominates. The finding holds.' captured-sheet='Defense' id='3'>
                    <capturedDeltas>
                      <datasource name='Parameters'>
                        <column name='[Parameter 2]' value='&quot;Measured Only (4,029)&quot;' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='The 2023 reform downgraded 9 real products by up to two grades.' captured-sheet='Reform Comparison' id='6'>
                    <capturedDeltas>
                      <worksheet name='Reform Comparison'>
                        <selection-collection>
                          <node-selection select-tuples='false'>
                            <oriented-node-reference orientation='horizontal'>
                              <node-reference>
                                <axis>[federated.05aqv360yj0qbo1asvsc80eqwkh8].[sum:Calculation_0645988818407429:qk]</axis>
                              </node-reference>
                              <page-reference />
                            </oriented-node-reference>
                          </node-selection>
                        </selection-collection>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='The fix: drag one recipe lever and watch the grade flip live — D to C.' captured-sheet='Diagnosis → Simulator' id='4' />
                  <story-point caption='Cutting salt lifts 2,837 products; adding protein barely helps — the protein cap.' captured-sheet='Scenario Ranking' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
