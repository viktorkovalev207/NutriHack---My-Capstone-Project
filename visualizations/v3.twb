            <column caption='Positive Points (protein/fibre)' datatype='real' default-format='n#,##0;-#,##0' name='[ns_positive_pts]' role='measure' type='quantitative' />
            <column caption='Nutri-Score Points' datatype='real' name='[ns_score]' role='measure' type='quantitative' />
            <column datatype='string' name='[product_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0645988818407429]' derivation='Sum' name='[sum:Calculation_0645988818407429:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ns_score]' derivation='Sum' name='[sum:ns_score:qk]' pivot='key' type='quantitative' />
