              <calculation class='tableau' formula='&quot;All Products (9,861)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05aqv360yj0qbo1asvsc80eqwkh8'>
            <column caption='Basis Filter' datatype='boolean' name='[Calculation_0645988796874752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;  WHEN &apos;All Products (9,861)&apos; THEN TRUE&#13;&#10;  WHEN &apos;Measured Only (4,029)&apos; THEN [data_basis] = &apos;measured&apos;&#13;&#10;END' />
            </column>
            <column caption='FVL Points' datatype='integer' name='[Calculation_0645988818345988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [fvl_pct] &lt;= 40 THEN 0&#13;&#10;ELSEIF [fvl_pct] &lt;= 60 THEN 1&#13;&#10;ELSEIF [fvl_pct] &lt;= 80 THEN 2&#13;&#10;ELSE 5 END' />
            </column>
            <column caption='Score Old Rule' datatype='real' name='[Calculation_0645988818407429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [ns_negative_pts] &gt;= 11 AND [Calculation_0645988818345988] = 5&#13;&#10;THEN [ns_negative_pts] - [ns_positive_pts]&#13;&#10;ELSE [ns_score] END' />
            </column>
            <column caption='Letter Old' datatype='string' name='[Calculation_0645988818448390]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0645988818407429] &lt; 1 THEN &apos;A&apos;&#13;&#10;ELSEIF [Calculation_0645988818407429] &lt; 3 THEN &apos;B&apos;&#13;&#10;ELSEIF [Calculation_0645988818407429] &lt; 11 THEN &apos;C&apos;&#13;&#10;ELSEIF [Calculation_0645988818407429] &lt; 19 THEN &apos;D&apos;&#13;&#10;ELSE &apos;E&apos; END' />
            </column>
            <column caption='Reform Switcher' datatype='boolean' name='[Calculation_0645988818505735]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_0645988818448390] != [ns_letter]' />
            </column>
            <column-instance column='[Calculation_0645988818448390]' derivation='Attribute' name='[attr:Calculation_0645988818448390:nk]' pivot='key' type='nominal' />
            <column-instance column='[ns_letter]' derivation='Attribute' name='[attr:ns_letter:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[data_basis]' role='dimension' type='nominal' />
            <column datatype='real' name='[fvl_pct]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0645988796874752]' derivation='None' name='[none:Calculation_0645988796874752:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0645988818505735]' derivation='None' name='[none:Calculation_0645988818505735:nk]' pivot='key' type='nominal' />
            <column-instance column='[ns_letter]' derivation='None' name='[none:ns_letter:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_name]' derivation='None' name='[none:product_name:nk]' pivot='key' type='nominal' />
