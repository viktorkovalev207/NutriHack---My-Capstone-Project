      <column caption='Lbl All' datatype='string' name='[Calculation_0645988813586434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;All Products (9,861)&apos;' />
      </column>
      <column caption='Lbl Measured' datatype='string' name='[Calculation_0645988814368771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Measured Only (4,029)&apos;' />
      </column>
      <column caption='FVL Points' datatype='integer' name='[Calculation_0645988818345988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [fvl_pct] &lt;= 40 THEN 0&#13;&#10;ELSEIF [fvl_pct] &lt;= 60 THEN 1&#13;&#10;ELSEIF [fvl_pct] &lt;= 80 THEN 2&#13;&#10;ELSE 5 END' />
      </column>
      <column caption='Score Old Rule' datatype='real' name='[Calculation_0645988818407429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ns_negative_pts] &gt;= 11 AND [Calculation_0645988818345988] = 5&#13;&#10;THEN [ns_negative_pts] - [ns_positive_pts]&#13;&#10;ELSE [ns_score] END' />
      </column>
      <column caption='Letter Old' datatype='string' name='[Calculation_0645988818448390]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0645988818407429] &lt; 1 THEN &apos;A&apos;&#13;&#10;ELSEIF [Calculation_0645988818407429] &lt; 3 THEN &apos;B&apos;&#13;&#10;ELSEIF [Calculation_0645988818407429] &lt; 11 THEN &apos;C&apos;&#13;&#10;ELSEIF [Calculation_0645988818407429] &lt; 19 THEN &apos;D&apos;&#13;&#10;ELSE &apos;E&apos; END' />
      </column>
      <column caption='Reform Switcher' datatype='boolean' name='[Calculation_0645988818505735]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0645988818448390] != [ns_letter]' />
      </column>
      <column caption='Dimension Selected' datatype='string' name='[Calculation_0645988827176968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;  WHEN &apos;Grade&apos; THEN [ns_letter]&#13;&#10;  WHEN &apos;Category&apos; THEN [product_type]&#13;&#10;  WHEN &apos;Data Basis&apos; THEN [data_basis]&#13;&#10;END' />
      </column>
      <column caption='Jitter' datatype='real' name='[Calculation_0645988827254793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL(FLOAT(RIGHT(STR([barcode]), 2)), 50) / 99) - 0.5' />
      </column>
      <column caption='Improve Salt -0.3' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0645988830785546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([sim_salt_minus03_improved]))' />
      </column>
      <column caption='Improve Fibre +3' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0645988830949387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([sim_fibre_plus3_improved]))' />
      </column>
      <column caption='Improve Sugar -10' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0645988830994444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([sim_sugar_minus10_improved]))' />
      </column>
      <column caption='Improve Sugar -5' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0645988831055885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([sim_sugar_minus5_improved]))' />
      </column>
      <column caption='Improve Protein +10' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0645988831125518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([sim_protein_plus10_improved]))' />
      </column>
      <column caption='Improve Protein +5' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0645988831182863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([sim_protein_plus5_improved]))' />
      </column>
